---
import Base from '../layouts/Base.astro';
---
<Base title="Privacy policy">
  <section class="section">
    <div class="wrap narrow">
      <span class="eyebrow">Legal</span>
      <h1>Privacy policy</h1>
      <p class="note">Text to be supplied: what personal data is collected (e.g. inquiry emails), how it is used and stored, and visitors' rights under the GDPR. Needed because many guests come from Europe.</p>
    </div>
  </section>
</Base>

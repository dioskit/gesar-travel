---
import Base from '../layouts/Base.astro';
import DestinationPanels from '../components/DestinationPanels.astro';
import Marquee from '../components/Marquee.astro';
import AltitudeGauge from '../components/AltitudeGauge.astro';
import Months from '../components/Months.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { whatsappLink } from '../data/site.js';

const places = ['Leh', 'Nubra', 'Zanskar', 'Changthang', 'Markha Valley', 'Tso Moriri', 'Paro', 'Punakha', 'Kangchenjunga', 'Darjeeling', 'Rajasthan', 'Varanasi'];
const stats = [
  { n: '2004', l: 'Founded in Leh by Tashi Wangail' },
  { n: '~20', l: 'Years Tashi guided before founding Gesar' },
  { n: '7', l: 'Guides & organisers – most from Nubra and Zanskar' },
  { n: '2–10', l: 'Travellers per group, never more' },
];
---
<Base title="Home" overlayHeader>
  <AltitudeGauge />

  <!-- Hero -->
  <section class="hero">
    <video class="hero__media" autoplay muted loop playsinline preload="auto" poster="/video/hero-poster.jpg" aria-hidden="true" data-hero-video>
      <source src="/video/hero-loop.mp4" type="video/mp4" />
    </video>
    <div class="hero__shade"></div>
    <div class="wrap hero__content">
      <span class="eyebrow reveal">Himalaya specialists · Leh, Ladakh</span>
      <h1 class="mega reveal reveal-delay-1">Journeys into<br />the <span class="accent">Himalayas</span></h1>
      <div class="hero__row reveal reveal-delay-2">
        <p>Tailor-made travel, trekking and expeditions in Ladakh, Bhutan, Sikkim and North India – planned by the people who live here.</p>
        <div class="hero__ctas">
          <a href="/contact/#inquiry" class="btn btn--light">Build your trip</a>
          <a href={whatsappLink()} target="_blank" rel="noopener" class="hero__wa"><WhatsAppIcon /> Ask us on WhatsApp</a>
        </div>
      </div>
      <button type="button" class="film-btn reveal reveal-delay-3" data-film-open>
        <span class="film-btn__play" aria-hidden="true"></span>
        <span><b>Watch the film</b> This is trekking in Ladakh · 4:47</span>
      </button>
    </div>
    <div class="hero__scroll" aria-hidden="true"><span></span>Scroll to climb</div>
  </section>

  <dialog class="film" data-film aria-label="Film: This is trekking in Ladakh">
    <button type="button" class="film__close" data-film-close aria-label="Close film">×</button>
    <video controls preload="none" playsinline poster="/video/hero-poster.jpg" data-film-video>
      <source src="/video/trekking-in-ladakh.mp4" type="video/mp4" />
    </video>
  </dialog>

  <script>
    const hero = document.querySelector<HTMLVideoElement>('[data-hero-video]');
    if (hero && matchMedia('(prefers-reduced-motion: reduce)').matches) hero.pause();

    const dialog = document.querySelector<HTMLDialogElement>('[data-film]')!;
    const film = document.querySelector<HTMLVideoElement>('[data-film-video]')!;
    document.querySelector('[data-film-open]')?.addEventListener('click', () => {
      dialog.showModal();
      hero?.pause();
      film.play().catch(() => {});
    });
    const close = () => dialog.close();
    document.querySelector('[data-film-close]')?.addEventListener('click', close);
    dialog.addEventListener('click', (e) => { if (e.target === dialog) close(); });
    dialog.addEventListener('close', () => {
      film.pause();
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) hero?.play().catch(() => {});
    });
  </script>

  <Marquee items={places} />

  <!-- Where do you want to travel? -->
  <section class="section">
    <div class="wrap">
      <div class="intro">
        <div class="reveal">
          <hr class="flagline flagline--short" />
          <h2>Where do you want <span class="accent">to travel?</span></h2>
        </div>
        <p class="lead reveal reveal-delay-1">
          We started in Ladakh and only slowly added other destinations. Rapid growth is not our way – we wait until
          we truly know a place before we take you there. And that works in your favour.
        </p>
      </div>
      <div class="reveal"><DestinationPanels /></div>
    </div>
  </section>

  <!-- Who we are -->
  <section class="section section--paper">
    <div class="wrap">
      <div class="who">
        <figure class="who__img reveal">
          <img src="/images/temp/ladakh-farmer.jpg" alt="A smiling Ladakhi farmer during the barley harvest" loading="lazy" />
          <figcaption>Harvest time in Ladakh</figcaption>
        </figure>
        <div class="who__text">
          <span class="eyebrow reveal">Who we are</span>
          <h2 class="reveal">Twenty years on the trail <span class="accent">before</span> the first booking</h2>
          <p class="reveal">
            Gesar Travel was founded in 2004 by Tashi Wangail in Leh, and has since accompanied many hundreds of
            travellers through the Himalayas. Tashi guided for almost two decades before starting the agency – he knows
            Ladakh and the Himalayan regions of India inside out.
          </p>
          <p class="reveal">That field knowledge, plus careful logistics, is what lets us design a trip around you.</p>
          <a href="/team/" class="link-arrow reveal">Meet the team</a>
        </div>
      </div>
      <dl class="stats">
        {stats.map((s, i) => (
          <div class:list={['reveal', `reveal-delay-${i}`]}><dt class="kicker-num">{s.n}</dt><dd>{s.l}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <!-- We love the mountains -->
  <section class="section love">
    <div class="wrap love__grid">
      <div class="love__text">
        <span class="eyebrow reveal">Our passion</span>
        <p class="love__big reveal">
          Only in the mountains do we feel truly <span class="accent">free</span> – and at one with ourselves.
        </p>
        <p class="lead reveal">
          Trekking and expeditions are our passion. We can’t imagine a better holiday, or a better way to find yourself.
        </p>
      </div>
      <img class="love__a reveal" src="/images/temp/ladakh-monks.jpg" alt="Monks and a young novice at prayer" loading="lazy" />
      <img class="love__b reveal reveal-delay-2" src="/images/temp/ladakh-thiksey.jpg" alt="Thiksey monastery" loading="lazy" />
    </div>
  </section>

  <!-- Quote -->
  <section class="quote">
    <div class="quote__bg" style="background-image:url(/images/temp/ladakh-peaks.jpg)"></div>
    <div class="wrap">
      <blockquote class="reveal">
        “Mountains are voiceless masters and make silent disciples.”
        <cite>Johann Wolfgang von Goethe</cite>
      </blockquote>
    </div>
  </section>

  <!-- Two ways to travel -->
  <section class="section">
    <div class="wrap">
      <div class="center narrow reveal" style="margin-bottom:56px">
        <hr class="flagline flagline--short" />
        <h2>Your trip, <span class="accent">your way</span></h2>
      </div>
      <div class="ways">
        <a href="/individual-tours/" class="way reveal">
          <img src="/images/temp/individual-girl.jpg" alt="" loading="lazy" />
          <div class="way__body">
            <span class="way__tag">Most popular</span>
            <h3>Individual tours</h3>
            <p>You choose the length, the group and the activities. We design the trip around you.</p>
            <span class="link-arrow">Plan an individual tour</span>
          </div>
        </a>
        <a href="/group-tours/" class="way reveal reveal-delay-1">
          <img src="/images/temp/group-window.jpg" alt="" loading="lazy" />
          <div class="way__body">
            <span class="way__tag">2–10 people</span>
            <h3>Small-group tours</h3>
            <p>Tried-and-tested itineraries – and almost all can be booked privately, too.</p>
            <span class="link-arrow">See group tours</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Wildlife teaser -->
  <section class="section section--slate">
    <div class="wrap split split--wide-img">
      <div class="reveal">
        <span class="eyebrow">Wildlife collection</span>
        <h2>Snow leopards, kiangs <span class="accent">&amp; cranes</span></h2>
        <p class="lead">What you can see, where to find it – and in which months.</p>
        <div class="season">
          <span>Kiang on the Changthang</span>
          <Months on={[5, 10]} best={[6, 7, 8, 9]} label="Kiang season" />
        </div>
        <a href="/wildlife/" class="btn btn--light" style="margin-top:28px">Explore the wildlife</a>
      </div>
      <img src="/images/temp/wildlife-kiang.jpg" alt="A herd of kiang galloping across the Changthang plateau" class="ratio-3-2 reveal reveal-delay-1" loading="lazy" />
    </div>
  </section>

  <!-- Plan CTA -->
  <section class="plan">
    <div class="wrap plan__inner">
      <h2 class="reveal">Ready when you are. <span class="accent">Tell us your dream trip.</span></h2>
      <div class="plan__ctas reveal reveal-delay-1">
        <a href="/contact/#inquiry" class="btn btn--saffron">Build your trip – 2 minutes</a>
        <a href={whatsappLink()} target="_blank" rel="noopener" class="btn btn--wa"><WhatsAppIcon /> WhatsApp us</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero { position: relative; min-height: 100svh; display: flex; align-items: flex-end; color: var(--white); overflow: hidden; background: var(--ink); }
  .hero__media { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  .film-btn {
    display: inline-flex; align-items: center; gap: 14px; margin-top: 40px; padding: 0;
    background: none; border: 0; color: var(--white); cursor: pointer; text-align: left;
    font: 400 .85rem/1.4 var(--sans);
  }
  .film-btn b { display: block; font-family: var(--serif); font-weight: 400; font-size: 1.15rem; }
  .film-btn span:last-child { color: rgba(255,255,255,.75); }
  .film-btn__play {
    position: relative; flex: none; width: 56px; height: 56px; border-radius: 50%;
    border: 1px solid rgba(255,255,255,.6); transition: background .3s, border-color .3s;
  }
  .film-btn__play::after { content: ''; position: absolute; left: 22px; top: 18px; border-left: 16px solid var(--white); border-top: 10px solid transparent; border-bottom: 10px solid transparent; }
  .film-btn:hover .film-btn__play { background: var(--saffron); border-color: var(--saffron); }

  .film { width: min(1200px, 94vw); padding: 0; border: 0; background: #000; border-radius: var(--radius); overflow: visible; }
  .film::backdrop { background: rgba(10,14,17,.88); backdrop-filter: blur(4px); }
  .film video { display: block; width: 100%; aspect-ratio: 16 / 9; background: #000; border-radius: var(--radius); }
  .film__close { position: absolute; top: -48px; right: 0; width: 40px; height: 40px; border: 0; border-radius: 50%; background: var(--white); color: var(--ink); font-size: 1.6rem; line-height: 1; cursor: pointer; }
  .hero__shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(15,22,27,.55) 0%, rgba(15,22,27,0) 65%), linear-gradient(180deg, rgba(15,22,27,.5) 0%, rgba(15,22,27,0) 30%, rgba(15,22,27,.8) 100%); }
  .hero__content { position: relative; padding-top: 140px; padding-bottom: clamp(72px, 10vw, 120px); }
  .hero .eyebrow { color: var(--saffron); }
  .hero h1 { margin-bottom: 36px; }
  .hero .accent { color: var(--saffron); }
  .hero__row { display: grid; gap: 28px; align-items: end; }
  @media (min-width: 900px) { .hero__row { grid-template-columns: minmax(0, 520px) auto; justify-content: space-between; } }
  .hero__row p { font-size: clamp(1.05rem, 1.5vw, 1.25rem); color: rgba(255,255,255,.9); margin: 0; }
  .hero__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 22px; }
  .hero__wa { display: inline-flex; align-items: center; gap: 8px; color: var(--white); font-weight: 500; text-decoration: none; border-bottom: 1px solid rgba(255,255,255,.5); padding-bottom: 3px; }
  .hero__wa:hover { border-color: #25d366; }
  .hero__scroll { position: absolute; left: 50%; bottom: 22px; transform: translateX(-50%); display: none; flex-direction: column; align-items: center; gap: 8px; font: 500 .65rem var(--sans); letter-spacing: .2em; text-transform: uppercase; color: rgba(255,255,255,.7); }
  .hero__scroll span { width: 1px; height: 36px; background: linear-gradient(var(--saffron), transparent); animation: cue 2s ease-in-out infinite; transform-origin: top; }
  @keyframes cue { 0% { transform: scaleY(0); } 50% { transform: scaleY(1); } 100% { transform: scaleY(1); opacity: 0; } }
  @media (min-width: 900px) and (min-height: 760px) { .hero__scroll { display: flex; } }
  @media (prefers-reduced-motion: reduce) { .hero__scroll span { animation: none; } }

  .intro { display: grid; gap: 24px 64px; margin-bottom: 56px; align-items: end; }
  @media (min-width: 860px) { .intro { grid-template-columns: 5fr 6fr; } }
  .intro h2 { margin-bottom: 0; font-size: clamp(2.4rem, 5vw, 4rem); }

  /* Who we are */
  .who { display: grid; gap: 48px; align-items: center; }
  @media (min-width: 900px) { .who { grid-template-columns: 6fr 5fr; gap: 80px; } }
  .who__img { margin: 0; position: relative; }
  .who__img img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--radius); }
  @media (min-width: 900px) { .who__img img { aspect-ratio: 5 / 6; } }
  .who__img figcaption { position: absolute; left: 20px; bottom: 20px; background: var(--white); padding: 8px 14px; font: 500 .75rem var(--sans); letter-spacing: .1em; text-transform: uppercase; border-radius: 2px; }
  .who__text h2 { font-size: clamp(2rem, 3.6vw, 3rem); }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 32px; margin: clamp(64px, 8vw, 104px) 0 0; padding-top: 40px; border-top: 1px solid var(--line); }
  .stats dt { color: var(--ink); }
  .stats dd { margin: 10px 0 0; color: var(--ink-soft); font-size: .92rem; max-width: 24ch; }
  .stats > div:nth-child(1) dt { color: var(--flag-blue); }
  .stats > div:nth-child(2) dt { color: var(--flag-red); }
  .stats > div:nth-child(3) dt { color: var(--flag-green); }
  .stats > div:nth-child(4) dt { color: var(--saffron-deep); }

  /* We love the mountains – staggered collage */
  .love__grid { display: grid; gap: 28px; }
  .love__big { font-family: var(--serif); font-size: clamp(2rem, 4.4vw, 3.8rem); line-height: 1.12; letter-spacing: -.02em; margin-bottom: 28px; }
  .love__a, .love__b { width: 100%; object-fit: cover; border-radius: var(--radius); }
  .love__a { aspect-ratio: 16 / 10; }
  .love__b { aspect-ratio: 3 / 2; }
  @media (min-width: 960px) {
    .love__grid { grid-template-columns: repeat(12, 1fr); grid-template-rows: auto auto; align-items: start; }
    .love__text { grid-column: 1 / 7; grid-row: 1; padding-top: 40px; }
    .love__a { grid-column: 7 / 13; grid-row: 1 / 3; aspect-ratio: 4 / 5; }
    .love__b { grid-column: 3 / 7; grid-row: 2; margin-top: 24px; }
  }

  /* Quote with fixed background on desktop */
  .quote { position: relative; padding: clamp(140px, 20vw, 260px) 0; color: var(--white); overflow: hidden; background: var(--ink); }
  .quote__bg { position: absolute; inset: 0; background-size: cover; background-position: center; opacity: .38; }
  @media (min-width: 900px) and (hover: hover) { .quote__bg { background-attachment: fixed; } }
  .quote .wrap { position: relative; }
  .quote blockquote { margin: 0 auto; max-width: 980px; text-align: center; font-family: var(--serif); font-style: italic; font-size: clamp(2rem, 4.6vw, 3.8rem); line-height: 1.2; }
  .quote cite { display: block; margin-top: 28px; font: 500 .8rem/1 var(--sans); font-style: normal; letter-spacing: .2em; text-transform: uppercase; color: var(--saffron); }

  /* Ways */
  .ways { display: grid; gap: 24px; }
  @media (min-width: 860px) { .ways { grid-template-columns: 1fr 1fr; } }
  .way { position: relative; display: block; overflow: hidden; border-radius: var(--radius); color: var(--white); text-decoration: none; aspect-ratio: 4 / 5; background: var(--ink); }
  @media (min-width: 860px) { .way { aspect-ratio: 5 / 6; } }
  .way img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 1s cubic-bezier(.2,.7,.2,1); }
  .way::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 35%, rgba(15,22,27,.9)); }
  .way:hover img { transform: scale(1.05); }
  .way__body { position: absolute; left: 0; right: 0; bottom: 0; z-index: 1; padding: clamp(24px, 4vw, 40px); }
  .way__tag { display: inline-block; margin-bottom: 14px; padding: 6px 12px; background: var(--saffron); color: var(--ink); font: 600 .7rem var(--sans); letter-spacing: .12em; text-transform: uppercase; border-radius: 2px; }
  .way h3 { font-size: clamp(1.8rem, 3vw, 2.6rem); }
  .way p { color: rgba(255,255,255,.85); max-width: 40ch; }

  .season { margin-top: 28px; max-width: 420px; }
  .season > span { display: block; margin-bottom: 8px; font: 600 .72rem var(--sans); letter-spacing: .14em; text-transform: uppercase; color: var(--saffron); }
  .section--slate :global(.months span) { background: rgba(255,255,255,.08); color: rgba(255,255,255,.6); }
  .section--slate :global(.months span.on) { background: var(--flag-green); color: var(--white); }
  .section--slate :global(.months span.best) { background: var(--saffron); color: var(--ink); }

  /* Plan CTA */
  .plan { background: var(--paper); padding: clamp(80px, 12vw, 150px) 0; }
  .plan__inner { display: grid; gap: 36px; align-items: end; }
  @media (min-width: 960px) { .plan__inner { grid-template-columns: 7fr 5fr; } }
  .plan h2 { font-size: clamp(2.2rem, 4.6vw, 3.8rem); margin: 0; }
  .plan__ctas { display: flex; flex-wrap: wrap; gap: 14px; }
  @media (min-width: 960px) { .plan__ctas { justify-content: flex-end; } }
</style>

---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Months from '../components/Months.astro';
import { wildlife } from '../data/wildlife.js';
const regions = [...new Set(wildlife.flatMap((w) => w.regions))];
const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
---
<Base title="Wildlife" overlayHeader description="Where and when to see snow leopards, kiangs, black-necked cranes, red pandas and more in the Himalayas.">
  <Hero image="/images/temp/wildlife-kiang.jpg" eyebrow="Wildlife collection" title="Wild <span class='accent'>Himalaya</span>">
    <p>A field guide to what you can see, where to find it, and the best months to go.</p>
  </Hero>

  <section class="section">
    <div class="wrap">
      <div class="finder">
        <div>
          <span class="finder__label">Where</span>
          <div class="filters" role="group" aria-label="Filter by region">
            <button class="is-on" data-region="all">Everywhere</button>
            {regions.map((r) => <button data-region={r}>{r}</button>)}
          </div>
        </div>
        <div>
          <span class="finder__label">When are you travelling?</span>
          <div class="filters filters--months" role="group" aria-label="Filter by month">
            <button class="is-on" data-month="0">Any</button>
            {monthNames.map((m, i) => <button data-month={i + 1}>{m}</button>)}
          </div>
        </div>
        <p class="finder__count" aria-live="polite"><span data-count>{wildlife.length}</span> species match</p>
      </div>

      <div class="legend">
        <span><i class="best"></i>Best months</span>
        <span><i class="on"></i>Possible</span>
      </div>

      <div class="grid grid--3 animals">
        {wildlife.map((w, i) => (
          <article class="card reveal" data-regions={w.regions.join('|')} data-months={[...w.months.on, ...w.months.best].join('|')}>
            <div class="card__media">
              {w.image
                ? <img src={w.image} alt={w.name} loading="lazy" />
                : <div class="photo-placeholder">Photo to come</div>}
              <span class="card__no">No. {String(i + 1).padStart(2, '0')}</span>
              <span class="card__region">{w.regions.join(' · ')}</span>
            </div>
            <div class="card__body">
              <h3>{w.name}</h3>
              <p class="latin">{w.latin}</p>
              <Months on={w.months.on} best={w.months.best} label={`${w.name} season`} />
              <p class="when">{w.when}</p>
              <p class="where"><b>Where</b>{w.where}</p>
              <p class="desc">{w.note}</p>
            </div>
          </article>
        ))}
      </div>
      <p class="empty" data-empty hidden>No match for that combination – ask us, we may still know a spot.</p>

      <div class="cta">
        <h2>Want to see one <span class="accent">in the wild?</span></h2>
        <a href="/contact/#inquiry" class="btn">Plan a wildlife trip</a>
      </div>
    </div>
  </section>
</Base>

<script>
  let region = 'all';
  let month = '0';
  const apply = () => {
    let n = 0;
    document.querySelectorAll<HTMLElement>('[data-regions]').forEach((card) => {
      const okRegion = region === 'all' || card.dataset.regions!.split('|').includes(region);
      const okMonth = month === '0' || card.dataset.months!.split('|').includes(month);
      card.hidden = !(okRegion && okMonth);
      if (!card.hidden) n++;
    });
    document.querySelector('[data-count]')!.textContent = String(n);
    document.querySelector<HTMLElement>('[data-empty]')!.hidden = n > 0;
  };
  const wire = (attr: 'region' | 'month', set: (v: string) => void) => {
    const btns = document.querySelectorAll<HTMLButtonElement>(`[data-${attr}]`);
    btns.forEach((b) => b.addEventListener('click', () => {
      btns.forEach((x) => x.classList.toggle('is-on', x === b));
      set(b.dataset[attr]!);
      apply();
    }));
  };
  wire('region', (v) => (region = v));
  wire('month', (v) => (month = v));
</script>

<style>
  .finder { display: grid; gap: 24px; padding: clamp(24px, 3vw, 36px); background: var(--paper); border-radius: var(--radius); margin-bottom: 28px; }
  @media (min-width: 1000px) {
    .finder { grid-template-columns: 1fr auto; align-items: end; gap: 28px 40px; }
    .finder > div:nth-child(2) { grid-column: 1 / -1; grid-row: 2; }
    .finder__count { grid-column: 2; grid-row: 1; }
  }
  .finder__label { display: block; margin-bottom: 10px; font: 600 .72rem var(--sans); letter-spacing: .16em; text-transform: uppercase; color: var(--saffron-deep); }
  .finder__count { margin: 0; font-family: var(--serif); font-size: 1.2rem; white-space: nowrap; }
  .finder__count span { font-size: 2.2rem; }
  .filters { display: flex; flex-wrap: wrap; gap: 6px; }
  .filters button { font: 500 .85rem var(--sans); padding: 9px 16px; border: 1px solid var(--line); border-radius: 999px; background: var(--white); color: var(--ink); cursor: pointer; transition: background .2s, color .2s; }
  .filters button:hover { border-color: var(--ink-soft); }
  .filters button.is-on { background: var(--ink); color: var(--white); border-color: var(--ink); }
  .filters--months button { padding: 9px 11px; min-width: 44px; }

  .legend { display: flex; gap: 20px; margin-bottom: 40px; font-size: .82rem; color: var(--ink-soft); }
  .legend span { display: inline-flex; align-items: center; gap: 8px; }
  .legend i { width: 14px; height: 14px; border-radius: 2px; }
  .legend .best { background: var(--saffron); }
  .legend .on { background: var(--flag-green); }

  .animals { gap: 40px 28px; }
  .card { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; transition: transform .3s, box-shadow .3s; }
  .card:hover { transform: translateY(-4px); box-shadow: 0 18px 40px rgba(31,42,48,.1); }
  .card__media { position: relative; }
  .card__media img, .card__media .photo-placeholder { aspect-ratio: 4 / 3; width: 100%; object-fit: cover; border-radius: 0; }
  .card__no, .card__region { position: absolute; top: 14px; padding: 5px 10px; font: 600 .68rem var(--sans); letter-spacing: .14em; text-transform: uppercase; border-radius: 2px; }
  .card__no { left: 14px; background: var(--ink); color: var(--white); }
  .card__region { right: 14px; background: var(--white); color: var(--ink); }
  .card__body { padding: 24px; }
  .card h3 { margin-bottom: 2px; }
  .latin { font-style: italic; color: var(--muted); font-size: .9rem; margin-bottom: 18px; }
  .when { font-size: .82rem; color: var(--ink-soft); margin: 8px 0 16px; }
  .where { font-size: .92rem; margin-bottom: 10px; }
  .where b { display: block; font: 600 .68rem var(--sans); letter-spacing: .14em; text-transform: uppercase; color: var(--saffron-deep); margin-bottom: 2px; }
  .desc { color: var(--ink-soft); font-size: .92rem; }
  .empty { text-align: center; color: var(--ink-soft); padding: 40px 0; }

  .cta { display: grid; gap: 24px; justify-items: center; text-align: center; margin-top: clamp(64px, 8vw, 104px); }
  .cta h2 { margin: 0; }
</style>

---
import Base from './Base.astro';
const { frontmatter } = Astro.props;
---
<Base title={frontmatter.title} description={frontmatter.excerpt}>
  <article class="section">
    <div class="wrap narrow">
      <a href="/blog/" class="link-arrow">All posts</a>
      <h1 style="margin-top:32px">{frontmatter.title}</h1>
      <img src={frontmatter.image} alt="" class="cover" />
      <div class="prose"><slot /></div>
    </div>
  </article>
</Base>

<style>
  h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); }
  .cover { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--radius); margin: 32px 0 48px; }
  .prose { font-size: 1.08rem; }
  .prose :global(h2) { font-size: 1.8rem; margin-top: 1.6em; }
</style>

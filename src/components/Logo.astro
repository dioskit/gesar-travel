---
// Temporary mark echoing the old logo (sun + mountain arch). Replace with the real logo file when available.
---
<span class="logo">
  <svg viewBox="0 0 40 40" aria-hidden="true" width="34" height="34">
    <circle cx="20" cy="20" r="19" fill="#e4a335" />
    <path d="M9 31 V20 a11 11 0 0 1 22 0 V31 Z" fill="#5c6670" />
  </svg>
  <span class="logo__text">Gesar <span>Travel</span></span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; }
  .logo__text { font-family: var(--serif); font-size: 1.35rem; letter-spacing: 0.02em; line-height: 1; }
  .logo__text span { font-family: var(--sans); font-size: 0.68rem; letter-spacing: 0.24em; text-transform: uppercase; margin-left: 4px; opacity: .8; }
</style>
